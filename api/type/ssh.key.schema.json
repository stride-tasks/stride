{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://stride-tasks.github.io/stride/api/type/ssh.key.schema.json",
	"type": "object",
	"required": [
		"id",
		"format",
		"public-key",
		"public-path",
		"private-path"
	],
	"properties": {
		"id": {
			"type": "string",
			"format": "uuid"
		},
		"format": {
			"$ref": "https://stride-tasks.github.io/stride/api/type/ssh.key.format.schema.json"
		},
		"public-key": {
			"type": "string"
		},
		"public-path": {
			"type": "string",
			"format": "path"
		},
		"private-path": {
			"type": "string",
			"format": "path"
		}
	}
}