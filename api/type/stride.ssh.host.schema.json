{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://stride-tasks.github.io/stride/api/type/stride.ssh.host.schema.json",
	"title": "SSH Host",
	"type": "object",
	"required": [
		"hostname",
		"key"
	],
	"properties": {
		"hostname": {
			"type": "string",
			"description": "The hostname or IP address of the SSH host."
		},
		"key": {
			"$ref": "https://stride-tasks.github.io/stride/api/type/stride.ssh.key.public.schema.json",
			"description": "The SSH key used for authentication."
		}
	}
}