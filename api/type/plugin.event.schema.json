{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://stride-tasks.github.io/stride/api/type/plugin.event.schema.json",
    "type": "object",
    "required": [
        "type"
    ],
    "properties": {
        "type": {
            "type": "string",
            "$comment": "@discriminant"
        }
    },
    "oneOf": [
        {
            "properties": {
                "type": {
                    "const": "task-create"
                },
                "task": {
                    "$ref": "https://stride-tasks.github.io/stride/api/type/task.schema.json"
                }
            },
            "required": [
                "task"
            ]
        },
        {
            "properties": {
                "type": {
                    "const": "task-modify"
                },
                "task": {
                    "$ref": "https://stride-tasks.github.io/stride/api/type/task.schema.json"
                }
            },
            "required": [
                "task"
            ]
        },
        {
            "properties": {
                "type": {
                    "const": "task-query"
                },
                "query": {
                    "$ref": "https://stride-tasks.github.io/stride/api/type/task.query.schema.json"
                }
            },
            "required": [
                "query"
            ]
        },
        {
            "properties": {
                "type": {
                    "const": "task-sync"
                }
            }
        },
        {
            "properties": {
                "type": {
                    "const": "network-request"
                },
                "method": {
                    "$ref": "https://stride-tasks.github.io/stride/api/type/network.request.method.schema.json"
                },
                "host": {
                    "type": "string",
                    "format": "uri"
                }
            },
            "required": [
                "host"
            ]
        }
    ]
}