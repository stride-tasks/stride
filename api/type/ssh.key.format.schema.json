{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://stride-tasks.github.io/stride/api/type/ssh.key.format.schema.json",
	"title": "ssh.key.format",
	"description": "The type of SSH key used for authentication.",
	"type": "string",
	"anyOf": [
		{
			"const": "ssh-rsa",
			"description": "RSA key format."
		},
		{
			"const": "ssh-dss",
			"description": "DSA key format."
		},
		{
			"const": "ssh-ed25519",
			"description": "Ed25519 key format."
		},
		{
			"const": "ecdsa-sha2-nistp256",
			"description": "ECDSA key format with NIST P-256 curve."
		},
		{
			"const": "ecdsa-sha2-nistp384",
			"description": "ECDSA key format with NIST P-384 curve."
		},
		{
			"const": "ecdsa-sha2-nistp521",
			"description": "ECDSA key format with NIST P-521 curve."
		}
	]
}