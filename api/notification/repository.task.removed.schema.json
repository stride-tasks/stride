{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://stride-tasks.github.io/stride/api/notification/repository.task.removed.schema.json",
    "description": "Emitted after a task is removed from a repository.",
    "type": "object",
    "required": [
        "method",
        "params"
    ],
    "properties": {
        "method": {
            "type": "string",
            "const": "repository.task.removed"
        },
        "params": {
            "type": "object",
            "required": [
                "repository-id",
                "task-id"
            ],
            "properties": {
                "repository-id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "UUID of the repository that received the task."
                },
                "task-id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "UUID of the task that was removed."
                }
            }
        }
    }
}