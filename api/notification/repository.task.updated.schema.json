{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://stride-tasks.github.io/stride/api/notification/repository.task.updated.schema.json",
    "description": "Emitted after a task is updated in a repository.",
    "type": "object",
    "required": [
        "method",
        "params"
    ],
    "properties": {
        "method": {
            "type": "string",
            "const": "repository.task.updated"
        },
        "params": {
            "type": "object",
            "required": [
                "repository-id",
                "previous",
                "current"
            ],
            "properties": {
                "repository-id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "UUID of the repository that received the task."
                },
                "previous": {
                    "$ref": "https://stride-tasks.github.io/stride/api/type/task.schema.json",
                    "description": "The task before it was updated."
                },
                "current": {
                    "$ref": "https://stride-tasks.github.io/stride/api/type/task.schema.json",
                    "description": "The task after the update."
                }
            }
        }
    }
}