{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://stride-tasks.github.io/stride/api/notification/repository.sync.started.schema.json",
    "type": "object",
    "required": [
        "method",
        "params"
    ],
    "properties": {
        "method": {
            "type": "string",
            "const": "repository.sync.started"
        },
        "params": {
            "type": "object",
            "required": [
                "repository-id"
            ],
            "properties": {
                "repository-id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "UUID of the repository that started syncing."
                }
            }
        }
    }
}