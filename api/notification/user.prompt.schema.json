{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://stride-tasks.github.io/stride/api/notification/user.prompt.schema.json",
    "title": "Prompt",
    "description": "A prompt is a message or question that is presented to the user, often as part of an interactive system or application, and it may also include actions that the user can take in response to the prompt.",
    "type": "object",
    "properties": {
        "method": {
            "type": "string",
            "const": "user.prompt"
        },
        "params": {
            "type": "object",
            "properties": {
                "target": {
                    "$comment": "@name:UserPromptTarget",
                    "type": "object",
                    "properties": {
                        "method": {
                            "type": "string",
                            "description": "The name of the method to be invoked."
                        },
                        "params": {
                            "description": "The parameters for the method."
                        }
                    },
                    "required": [
                        "method",
                        "params"
                    ]
                },
                "summary": {
                    "type": "string",
                    "description": "A brief summary of the prompt."
                },
                "description": {
                    "type": "string",
                    "description": "A detailed description of the prompt."
                },
                "actions": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "description": "An action that the user can take in response to the prompt."
                    },
                    "description": "A list of actions that the user can take in response to the prompt."
                }
            },
            "required": [
                "method",
                "target",
                "summary",
                "actions"
            ]
        }
    }
}