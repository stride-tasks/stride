{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://stride-tasks.github.io/stride/api/notification/storage.changed.schema.json",
    "description": "Emitted after a key is added or changed in a storage.",
    "type": "object",
    "required": [
        "method",
        "params"
    ],
    "properties": {
        "method": {
            "type": "string",
            "const": "storage.changed"
        },
        "params": {
            "type": "object",
            "required": [
                "key",
                "value"
            ],
            "properties": {
                "repository-id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The repository the key belongs to, absent for the global storage."
                },
                "key": {
                    "type": "string",
                    "description": "The key that was added or changed."
                },
                "value": {
                    "$ref": "https://stride-tasks.github.io/stride/api/type/config.value.schema.json",
                    "description": "The new value."
                }
            }
        }
    }
}