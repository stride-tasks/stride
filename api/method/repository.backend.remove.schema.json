                "backend-id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The UUID of the backend to be removed from the repository."
                }
            },
            "required": [
                "repository-id",
                "backend-id"
            ]
        },
        "result": {
            "type": "object",
            "properties": {}
        }
    }
}