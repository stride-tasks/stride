{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://stride-tasks.github.io/stride/api/method/repository.sync.schema.json",
    "type": "object",
    "properties": {
        "method": {
            "type": "string",
            "const": "repository.sync"
        },
        "params": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The unique identifier of the repository to be synchronized."
                },
                "backends": {
                    "type": "array",
                    "description": "A list of backends to synchronize with the repository.",
                    "items": {
                        "type": "string",
                        "example": [
                            "git"
                        ]
                    }
                }
            },
            "required": [
                "id"
            ]
        },
        "result": {
            "type": "object",
            "properties": {}
        }
    },
    "required": [
        "method",
        "params"
    ]
}