{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://stride-tasks.github.io/stride/api/method/repository.backend.toggle.schema.json",
    "type": "object",
    "required": [
        "method",
        "params"
    ],
    "properties": {
        "method": {
            "type": "string",
            "const": "repository.backend.toggle"
        },
        "params": {
            "type": "object",
            "properties": {
                "repository-id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The unique identifier of the repository for which a backend should be toggled."
                },
                "backend-id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The unique identifier of the backend to be toggled for the repository."
                }
            },
            "required": [
                "repository-id",
                "backend-id"
            ]
        },
        "result": {
            "type": "object",
            "properties": {
                "state": {
                    "type": "boolean",
                    "description": "The new state of the backend that was toggled for the repository."
                }
            },
            "required": [
                "state"
            ]
        }
    }
}