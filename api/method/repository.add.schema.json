{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://stride-tasks.github.io/stride/api/method/repository.add.schema.json",
    "type": "object",
    "required": [
        "method",
        "params"
    ],
    "properties": {
        "method": {
            "type": "string",
            "const": "repository.add"
        },
        "params": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "The optional name of the repository."
                }
            }
        },
        "result": {
            "type": "object",
            "properties": {
                "repository-id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The unique identifier of the added repository."
                }
            },
            "required": [
                "repository-id"
            ]
        }
    }
}
