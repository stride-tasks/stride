{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://stride-tasks.github.io/stride/api/method/repository.tag.list.schema.json",
    "type": "object",
    "properties": {
        "method": {
            "type": "string",
            "const": "repository.tag.list"
        },
        "params": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The unique identifier of the repository whose tags should be listed."
                }
            },
            "required": [
                "id"
            ]
        },
        "result": {
            "type": "object",
            "properties": {
                "tags": {
                    "type": "array",
                    "description": "All non-deleted tags stored in the repository database.",
                    "items": {
                        "type": "string",
                        "description": "The tag name."
                    }
                }
            },
            "required": [
                "tags"
            ]
        }
    },
    "required": [
        "method",
        "params"
    ]
}