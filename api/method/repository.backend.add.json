{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://stride-tasks.github.io/stride/api/method/repository.backend.add.schema.json",
    "type": "object",
    "required": [
        "method",
        "params"
    ],
    "properties": {
        "method": {
            "type": "string",
            "const": "repository.backend.add"
        },
        "params": {
            "type": "object",
            "properties": {
                "repository-id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The unique identifier of the repository to which a backend should be added."
                },
                "backend": {
                    "type": "string",
                    "description": "The unique identifier of the backend to be added to the repository."
                }
            },
            "required": [
                "repository-id",
                "backend"
            ]
        },
        "result": {
            "type": "object",
            "properties": {
                "backend-id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The unique identifier of the backend that was added to the repository."
                }
            },
            "required": [
                "backend-id"
            ]
        }
    }
}