{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://stride-tasks.github.io/stride/api/method/plugin.import.schema.json",
    "type": "object",
    "required": [
        "method",
        "params"
    ],
    "properties": {
        "method": {
            "type": "string",
            "const": "plugin.import"
        },
        "params": {
            "type": "object",
            "properties": {
                "file-path": {
                    "type": "string",
                    "description": "The file path of the plugin to be imported."
                }
            },
            "required": [
                "file-path"
            ]
        },
        "result": {
            "type": "object",
            "properties": {}
        }
    }
}