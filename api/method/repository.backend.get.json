{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://stride-tasks.github.io/stride/api/method/repository.backend.get.schema.json",
    "type": "object",
    "required": [
        "method",
        "params"
    ],
    "properties": {
        "method": {
            "type": "string",
            "const": "repository.backend.get"
        },
        "params": {
            "type": "object",
            "properties": {
                "repository-id": {
                    "type": "string",
                    "format": "uuid"
                },
                "backend-id": {
                    "type": "string",
                    "format": "uuid"
                }
            },
            "required": [
                "repository-id",
                "backend-id"
            ]
        },
        "result": {
            "type": "object",
            "properties": {
                "backend-record": {
                    "description": "The backend record in the repository.",
                    "$ref": "https://stride-tasks.github.io/stride/api/type/backend.record.schema.json"
                }
            }
        }
    }
}