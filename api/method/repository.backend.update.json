{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://stride-tasks.github.io/stride/api/method/repository.backend.update.schema.json",
    "type": "object",
    "required": [
        "method",
        "params"
    ],
    "properties": {
        "method": {
            "type": "string",
            "const": "repository.backend.update"
        },
        "params": {
            "type": "object",
            "properties": {
                "repository-id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The unique identifier of the repository for which a backend should be updated."
                },
                "backend-instance": {
                    "description": "The instance of the backend to be updated for the repository.",
                    "$ref": "https://stride-tasks.github.io/stride/api/type/backend.instance.schema.json"
                }
            },
            "required": [
                "repository-id",
                "backend-instance"
            ]
        },
        "result": {
            "type": "object",
            "properties": {}
        }
    }
}