{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://stride-tasks.github.io/stride/api/method/ssh.key.add.schema.json",
    "type": "object",
    "required": [
        "method",
        "params"
    ],
    "properties": {
        "method": {
            "type": "string",
            "const": "ssh.key.add"
        },
        "params": {
            "type": "object",
            "required": [
                "format",
                "public-key",
                "private-key"
            ],
            "properties": {
                "format": {
                    "$ref": "https://stride-tasks.github.io/stride/api/type/ssh.key.format.schema.json"
                },
                "public-key": {
                    "type": "string"
                },
                "private-key": {
                    "type": "string"
                }
            }
        },
        "result": {
            "type": "object",
            "required": [
                "key"
            ],
            "properties": {
                "key": {
                    "$ref": "https://stride-tasks.github.io/stride/api/type/ssh.key.schema.json"
                }
            }
        }
    }
}
