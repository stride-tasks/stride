{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://stride-tasks.github.io/stride/api/method/repository.backend.list.schema.json",
    "type": "object",
    "required": [
        "method",
        "params"
    ],
    "properties": {
        "method": {
            "type": "string",
            "const": "repository.backend.list"
        },
        "params": {
            "type": "object",
            "properties": {
                "repository-id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The unique identifier of the repository from which a backend should be listed."
                }
            },
            "required": [
                "repository-id"
            ]
        },
        "result": {
            "type": "object",
            "properties": {
                "backends": {
                    "description": "The list of backend instances in the repository.",
                    "type": "array",
                    "items": {
                        "$ref": "https://stride-tasks.github.io/stride/api/type/backend.instance.schema.json"
                    }
                }
            },
            "required": [
                "backends"
            ]
        }
    }
}