#!/bin/sh

# Get location of the script
SCRIPTS_DIR="$( cd "$( dirname "$0" )" && pwd )"
APPNAME=stride-desktop
FLUTTER_DIR="$SCRIPTS_DIR/.."
FLUTTER="$FLUTTER_DIR/flutter"
BUILD_DIR="$FLUTTER_DIR/build/$APPNAME.AppDir"
APPIMAGETOOL="$FLUTTER_DIR/build/appimagetool"
APPIMAGETOOL_URL=https://github.com/AppImage/AppImageKit/releases/download/continuous/appimagetool-x86_64.AppImage

extract_field() {
  grep -oP "^$1:\s*\K.*" "$FLUTTER_DIR/pubspec.yaml" | sed 's/\s\+$//'
}

VERSION=$(extract_field version | sed 's/+/-/g')
HOMEPAGE_URL=$(extract_field homepage)
DESCRIPTION=$(extract_field description)
APPLICATION_ID=org.stridetasks.stride
DESKTOP_FILE_NAME=$APPLICATION_ID.desktop
SUMMARY=$(printf '%s' "$DESCRIPTION" | sed 's/[.]$//')

# Display commands and stop script at first fail.
set -e

cd "$FLUTTER_DIR"

"$FLUTTER" build linux --release

rm -rf "$BUILD_DIR"

mkdir -p "$BUILD_DIR"

cp -r build/linux/x64/release/bundle/. "$BUILD_DIR"

mv "$BUILD_DIR/stride" "$BUILD_DIR/$APPNAME"

ICON_SIZE=512 "$SCRIPTS_DIR/rasterize-image" "$FLUTTER_DIR/assets/icon/logo.svg" "$BUILD_DIR/logo.png"

# Keep system ABI and graphics-stack libraries from the host. Bundling these can
# conflict with host configuration or GPU vendor libraries at runtime.
is_host_library() {
  case "$(basename "$1")" in
    ld-linux*.so*|ld64.so*|libanl.so*|libBrokenLocale.so*|libc.so*|\
    libdl.so*|libm.so*|libnsl.so*|libnss_*.so*|libpthread.so*|\
    libresolv.so*|librt.so*|libutil.so*|\
    libfontconfig.so*|libexpat.so*|libepoxy.so*|\
    libEGL*.so*|libGL*.so*|libGLES*.so*|libOpenGL.so*|\
    libgbm.so*|libdrm*.so*|libwayland-*.so*|libvulkan.so*)
      return 0
      ;;
  esac
  return 1
}

copy_dependencies() {
  echo "Copying runtime dependencies..."

  find "$BUILD_DIR" -type f | while IFS= read -r binary; do
    file "$binary" | grep -q 'ELF' || continue

    chmod a+x "$binary"
    dependencies=$(LC_ALL=C LD_LIBRARY_PATH="$BUILD_DIR/lib" ldd "$binary")
    echo "Dependencies for $binary:"
    printf '%s\n\n' "$dependencies"

    if printf '%s\n' "$dependencies" | grep -q 'not found'; then
      echo "Missing dependencies for $binary:" >&2
      exit 1
    fi

    for dependency in $(printf '%s\n' "$dependencies" |
      awk '$2 == "=>" && $3 ~ /^\// { print $3 }'); do
      is_host_library "$dependency" && continue

      destination="$BUILD_DIR/lib/$(basename "$dependency")"
      if [ ! -e "$destination" ]; then
        cp -v -L "$dependency" "$destination"
        chmod a+x "$destination"
      fi
    done
  done
}

mkdir -p "$BUILD_DIR/lib"
copy_dependencies

cat > "$BUILD_DIR/AppRun" <<EOF
#!/bin/sh

SELF=\$(readlink -f "\$0")
HERE=\${SELF%/*}

export PATH="\${HERE}/usr/bin/:\${HERE}/usr/sbin/:\${HERE}/usr/games/:\${HERE}/bin/:\${HERE}/sbin/\${PATH:+:\$PATH}"
export LD_LIBRARY_PATH="\${HERE}/usr/lib/:\${HERE}/usr/lib/i386-linux-gnu/:\${HERE}/usr/lib/x86_64-linux-gnu/:\${HERE}/usr/lib32/:\${HERE}/usr/lib64/:\${HERE}/lib/:\${HERE}/lib/i386-linux-gnu/:\${HERE}/lib/x86_64-linux-gnu/:\${HERE}/lib32/:\${HERE}/lib64/\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}"
export PYTHONPATH="\${HERE}/usr/share/pyshared/\${PYTHONPATH:+:\$PYTHONPATH}"
export XDG_DATA_DIRS="\${HERE}/usr/share/\${XDG_DATA_DIRS:+:\$XDG_DATA_DIRS}"
export PERLLIB="\${HERE}/usr/share/perl5/:\${HERE}/usr/lib/perl5/\${PERLLIB:+:\$PERLLIB}"
export GSETTINGS_SCHEMA_DIR="\${HERE}/usr/share/glib-2.0/schemas/\${GSETTINGS_SCHEMA_DIR:+:\$GSETTINGS_SCHEMA_DIR}"
export QT_PLUGIN_PATH="\${HERE}/usr/lib/qt4/plugins/:\${HERE}/usr/lib/i386-linux-gnu/qt4/plugins/:\${HERE}/usr/lib/x86_64-linux-gnu/qt4/plugins/:\${HERE}/usr/lib32/qt4/plugins/:\${HERE}/usr/lib64/qt4/plugins/:\${HERE}/usr/lib/qt5/plugins/:\${HERE}/usr/lib/i386-linux-gnu/qt5/plugins/:\${HERE}/usr/lib/x86_64-linux-gnu/qt5/plugins/:\${HERE}/usr/lib32/qt5/plugins/:\${HERE}/usr/lib64/qt5/plugins/\${QT_PLUGIN_PATH:+:\$QT_PLUGIN_PATH}"

exec "\${HERE}/$APPNAME" "\$@"
EOF

chmod +x "$BUILD_DIR/AppRun"

# Desktop Entry Specification: https://specifications.freedesktop.org/desktop-entry-spec/1.0/recognized-keys.html
cat > "$BUILD_DIR/$DESKTOP_FILE_NAME" <<EOF
[Desktop Entry]
Type=Application
Terminal=false
Name=Stride
GenericName=Task Management
Exec=$APPNAME %u
Icon=logo
Categories=Utility;
EOF


# NOTE: AppStream metainfo file:
#       <https://www.freedesktop.org/software/appstream/docs/chap-Quickstart.html>
#       <https://www.freedesktop.org/software/appstream/metainfocreator>
mkdir -p "$BUILD_DIR/usr/share/applications"
cp "$BUILD_DIR/$DESKTOP_FILE_NAME" "$BUILD_DIR/usr/share/applications/"

mkdir -p "$BUILD_DIR/usr/share/metainfo"
cat > "$BUILD_DIR/usr/share/metainfo/$APPLICATION_ID.appdata.xml" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>$APPLICATION_ID</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <name>Stride Tasks</name>
  <summary>$SUMMARY</summary>
  <developer id="org.stridetasks">
    <name>Stride Tasks</name>
  </developer>
  <description>
    <p>$DESCRIPTION Use it to organize tasks and synchronize them with Git repositories.</p>
  </description>
  <launchable type="desktop-id">$DESKTOP_FILE_NAME</launchable>
  <url type="homepage">$HOMEPAGE_URL</url>
  <content_rating type="oars-1.1" />
  <provides>
    <binary>$APPNAME</binary>
  </provides>
</component>
EOF

if [ ! -x "$APPIMAGETOOL" ]; then
  curl --fail --location "$APPIMAGETOOL_URL" --output "$APPIMAGETOOL"
  chmod +x "$APPIMAGETOOL"
fi

export ARCH=x86_64
APPIMAGE_EXTRACT_AND_RUN=1 \
  "$APPIMAGETOOL" "$BUILD_DIR" "build/${APPNAME}_${VERSION}_${ARCH}.AppImage"
