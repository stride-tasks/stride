#!/bin/sh

VERSION=3.47.0

APP_DIR="$( cd "$( dirname "$0" )" && pwd )"
PROJECT_DIR="$( cd "$APP_DIR/.." && pwd )"
FLUTTER_DIR="$APP_DIR/.flutter"

cd "$APP_DIR"

if [ ! -e "$FLUTTER_DIR" ]; then
    git clone "--filter=tree:0" https://github.com/flutter/flutter "$FLUTTER_DIR" --branch "$VERSION"

    "$FLUTTER_DIR"/bin/flutter config --no-analytics
fi

if [ "$1" = "run" ] || [ "$1" = "build" ]; then
    echo "Ensuring code generation is up to date..."

    GENERATE_OUTPUT=$(cargo run \
        --release \
        --manifest-path "$PROJECT_DIR/Cargo.toml" \
        --package stride_api_codegen_cli \
        --bin stride_api_codegen \
        -- \
        generate-dart \
        --api-dir "$PROJECT_DIR/api" \
        --output "$APP_DIR/lib/api/generated.dart")

    EXIT_CODE=$?
    echo -n "$GENERATE_OUTPUT"
    if [ $EXIT_CODE -ne 0 ]; then
        echo "Error: Rust code generation failed with exit code $EXIT_CODE"
        exit $EXIT_CODE
    fi

    if printf '%s\n' "$GENERATE_OUTPUT" | grep -q "Regenerating:"; then
        "$FLUTTER_DIR"/bin/dart run build_runner build
    else
        echo "Generated file is up to date, skipping build_runner."
    fi
fi

exec "$FLUTTER_DIR"/bin/flutter $@
