{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "stride.type.ssh.key.public.schema.json",
	"title": "SSH Public Key",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"type",
		"public"
	],
	"properties": {
		"type": {
			"type": "string",
			"enum": [
				"ssh-rsa",
				"ssh-dss",
				"ssh-ed25519",
				"ecdsa-sha2-nistp256",
				"ecdsa-sha2-nistp384",
				"ecdsa-sha2-nistp521"
			],
			"description": "The type of SSH key used for authentication."
		},
		"public": {
			"type": "string",
			"description": "The SSH key used for authentication."
		}
	}
}